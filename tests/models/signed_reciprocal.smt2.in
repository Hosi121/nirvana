; Integer model for the selected 64-bit signed reciprocal kernel.
; Encoded M may be negative, with an X addition to recover the positive M.
; The word-level product and portable helpers are checked separately in
; signed_integer.smt2 and the native/C backend cohorts.
(set-logic QF_LIA)
(set-option :timeout 3000)
(set-option :produce-models true)
(declare-fun x () Int)
(assert (and (<= (- 9223372036854775808) x) (< x 9223372036854775808)))
(define-fun multiplier () Int @M@)
(define-fun encoded () Int @ENCODED@)
(define-fun base () Int 18446744073709551616)
(define-fun raw_high () Int (div (* x encoded) base))
(define-fun normalized_high () Int (+ raw_high (ite @ADD@ x 0)))
(define-fun positive_quotient () Int
  (+ (div normalized_high @POSTPOWER@) (ite (< x 0) 1 0)))
(define-fun quotient () Int (ite @NEGATE@ (- positive_quotient) positive_quotient))
(define-fun divisor () Int @SIGNED_D@)
(define-fun expected_positive () Int (ite (< x 0) (- (div (- x) @D@)) (div x @D@)))
(define-fun expected () Int (ite @NEGATE@ (- expected_positive) expected_positive))
(define-fun expected_remainder () Int (ite (< x 0) (- (mod (- x) @D@)) (mod x @D@)))
(echo "signed encoding plus X recovers the positive multiplier high word")
(push 1)
(assert (distinct normalized_high (div (* x multiplier) base)))
(check-sat)
(pop 1)
(echo "normalized high word fits a signed machine word")
(push 1)
(assert (or (< normalized_high (- 9223372036854775808)) (>= normalized_high 9223372036854775808)))
(check-sat)
(pop 1)
(echo "reciprocal quotient has C's truncation toward zero")
(push 1)
(assert (distinct quotient expected))
(check-sat)
(pop 1)
(echo "low subtraction has the exact signed remainder")
(push 1)
(assert (distinct (- x (* quotient divisor)) expected_remainder))
(check-sat)
(pop 1)
(echo "negative control: decrementing the magic multiplier breaks a real input")
(push 1)
(assert (= x @D@))
(define-fun wrong_positive () Int (+ (div (* x @WRONG_M@) @POWER@) (ite (< x 0) 1 0)))
(assert (distinct (ite @NEGATE@ (- wrong_positive) wrong_positive) expected))
(check-sat)
(get-value (x))
(pop 1)
(echo "positive control: the minimum signed input is admitted")
(push 1)
(assert (= x (- 9223372036854775808)))
(assert (= quotient expected))
(check-sat)
(pop 1)
