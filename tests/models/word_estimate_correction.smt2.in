; Independent mathematical interpretation of signed high multiply, word
; correction, arithmetic shift and logical estimate-sign correction.
(set-logic QF_LIA)
(set-option :timeout 5000)
(declare-fun n () Int)
(assert (and (<= (- @HALF@) n) (< n @HALF@)))
(define-fun product () Int (* n @ENCODED@))
(define-fun high () Int (div product @BASE@))
(define-fun core () Int (+ high (* @CORRECTION@ n)))
(define-fun estimate () Int (div core @POSTPOWER@))
(define-fun actual () Int (+ estimate (ite (< estimate 0) 1 0)))
(define-fun magnitude () Int (ite (< n 0) (- n) n))
(define-fun positive () Int (div magnitude @DIVISOR@))
(define-fun target () Int (ite @NEGATIVE@ (ite (< n 0) positive (- positive)) (ite (< n 0) (- positive) positive)))
(define-fun remainder () Int (- n (* actual @SIGNED_D@)))
(define-fun target_rem () Int (ite (< n 0) (- (mod magnitude @DIVISOR@)) (mod magnitude @DIVISOR@)))
(push)
(assert (or (< product (- @PRODUCT_HALF@)) (>= product @PRODUCT_HALF@)))
(check-sat)
(pop)
(push)
(assert (or (< core (- @HALF@)) (>= core @HALF@)))
(check-sat)
(pop)
(push)
(assert (distinct actual target))
(check-sat)
(pop)
(push)
(assert (distinct remainder target_rem))
(check-sat)
(pop)
(push)
; Sign extension after a word projection preserves both mathematical results.
(assert (or (distinct (- (mod (+ actual @HALF@) @BASE@) @HALF@) actual)
            (distinct (- (mod (+ remainder @HALF@) @BASE@) @HALF@) remainder)))
(check-sat)
(pop)
