; Pure arithmetic correspondence, independent of the Rust evaluator.
; These lemmas cover the portable helpers' math, not the C compiler or ISA.
(set-logic ALL)
(set-option :timeout 3000)
(set-option :produce-models true)
(declare-fun value () (_ BitVec 64))
(declare-fun count () (_ BitVec 64))
(define-fun n () (_ BitVec 64) (bvand count #x000000000000003f))
(define-fun fill () (_ BitVec 64) (bvneg (bvlshr value #x000000000000003f)))
(define-fun expanded () (_ BitVec 64)
  (ite (= n #x0000000000000000) value
    (bvor (bvlshr value n) (bvshl fill (bvsub #x0000000000000040 n)))))
(echo "masked arithmetic shift matches explicit sign fill")
(push 1)
(assert (distinct (bvashr value n) expanded))
(check-sat)
(pop 1)
(echo "negative control: logical shift loses the sign")
(push 1)
(assert (distinct (bvashr value n) (bvlshr value n)))
(check-sat)
(get-value (value count))
(pop 1)

(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun negative_a () Bool)
(declare-fun negative_b () Bool)
(define-fun p () Int 18446744073709551616)
(define-fun signed_a () Int (- a (ite negative_a p 0)))
(define-fun signed_b () Int (- b (ite negative_b p 0)))
(define-fun correction () Int (+ (ite negative_a b 0) (ite negative_b a 0)))
(define-fun corrected_product () Int
  (+ (- (* a b) (* p correction)) (ite (and negative_a negative_b) (* p p) 0)))
(echo "two's complement full-product expansion")
(push 1)
(assert (distinct (* signed_a signed_b) corrected_product))
(check-sat)
(pop 1)

; Cut the unsigned product into hi*2^64+lo; lo's bounds characterize its low word.
; The whole-word correction and the 2^128 term then drop out modulo 2^64.
(declare-fun hi () Int)
(declare-fun lo () Int)
(declare-fun c () Int)
(declare-fun sign_pair () Int)
(define-fun product () Int (+ (* hi p) lo (- (* c p)) (* sign_pair p p)))
(assert (and (<= 0 lo) (< lo p)))
(echo "the full-product quotient retains the exact whole-word correction")
(push 1)
(assert (distinct (div product p) (+ (- hi c) (* sign_pair p))))
(check-sat)
(pop 1)
(echo "the extra 2^128 product term vanishes in the high word")
(push 1)
(assert (distinct (mod (+ (- hi c) (* sign_pair p)) p) (mod (- hi c) p)))
(check-sat)
(pop 1)
(echo "negative control: dropping the high-word correction changes the value")
(push 1)
; Realizable unsigned cut for signed operands -1 and 1.
(assert (and (= hi 0) (= lo (- p 1)) (= c 1) (= sign_pair 0)))
(assert (distinct (mod (div product p) p) (mod hi p)))
(check-sat)
(get-value (hi lo c sign_pair))
(pop 1)
