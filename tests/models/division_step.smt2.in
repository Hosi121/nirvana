; Instantiate W, STEP=W+1, and MSB=W-1 for W=8/16/32/64.
; This verifies arithmetic lemmas, not the C parser/compiler or full x86 effects.
(set-logic QF_BV)
(set-option :produce-models true)
(set-option :timeout 3000)
(declare-fun divisor () (_ BitVec @W@))
(declare-fun remainder () (_ BitVec @W@))
(declare-fun low () (_ BitVec @W@))
(declare-fun bit () (_ BitVec 1))
(define-fun carry () Bool (= ((_ extract @MSB@ @MSB@) remainder) #b1))
(define-fun shifted () (_ BitVec @W@)
  (bvor (bvshl remainder (_ bv1 @W@)) ((_ zero_extend @MSB@) bit)))
(define-fun full () (_ BitVec @STEP@)
  (bvor (bvshl ((_ zero_extend 1) remainder) (_ bv1 @STEP@)) ((_ zero_extend @W@) bit)))
(define-fun subtract () Bool (or carry (bvuge shifted divisor)))
(define-fun next () (_ BitVec @W@) (ite subtract (bvsub shifted divisor) shifted))
(define-fun mathematical () (_ BitVec @STEP@)
  (ite (bvuge full ((_ zero_extend 1) divisor))
    (bvsub full ((_ zero_extend 1) divisor)) full))
(push 1)
(assert (not (= divisor (_ bv0 @W@))))
(assert (bvult remainder divisor))
(echo "restoring step preserves exact value and remainder bound")
(push 1)
(assert (not (and (= ((_ zero_extend 1) next) mathematical) (bvult next divisor))))
(check-sat)
(pop 1)
(echo "carry path is reachable")
(push 1)
(assert carry)
(assert subtract)
(check-sat)
(pop 1)
(echo "negative control: dropping carry breaks the step")
(push 1)
(assert (not (= ((_ zero_extend 1) (ite (bvuge shifted divisor) (bvsub shifted divisor) shifted)) mathematical)))
(check-sat)
(get-value (remainder divisor bit))
(pop 1)
(pop 1)
(echo "high-half overflow guard is exact")
(push 1)
(assert (not (= (bvult remainder divisor)
  (bvult (concat remainder low) (concat divisor (_ bv0 @W@))))))
(check-sat)
(pop 1)
(echo "two-word negation matches whole dividend magnitude")
(push 1)
(define-fun new_low () (_ BitVec @W@) (bvneg low))
(define-fun new_high () (_ BitVec @W@)
  (bvadd (bvnot remainder) (ite (= new_low (_ bv0 @W@)) (_ bv1 @W@) (_ bv0 @W@))))
(assert (not (= (concat new_high new_low) (bvneg (concat remainder low)))))
(check-sat)
(pop 1)
