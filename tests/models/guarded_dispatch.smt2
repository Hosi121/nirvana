; Control-choice lemma for module-normal-ram-calls-v1.
; The original target expression executes before the guard. Pure snapshot hints
; do not modify guest registers/RAM. A stopped prefix retains its fault/budget PC.
; This model proves the guarded dispatch choice, not the C backend or x86 ISA.
(set-logic QF_ABV)
(set-option :produce-models true)
(set-option :timeout 5000)
(declare-fun ready () Bool)
(declare-fun prefix_pc () (_ BitVec 64))
(declare-fun snapshot_valid () Bool)
(declare-fun snapshot_key () (_ BitVec 64))
(declare-fun case_key () (_ BitVec 64))
(declare-fun current_index () (_ BitVec 64))
(declare-fun hint_base () (_ BitVec 64))
(declare-fun current_base () (_ BitVec 64))
(define-fun key_match () Bool
  (and snapshot_valid (= snapshot_key case_key)))

; Absolute 64-bit table: initial image and current guest RAM are independent.
(push 1)
(declare-fun image64 () (Array (_ BitVec 64) (_ BitVec 64)))
(declare-fun ram64 () (Array (_ BitVec 64) (_ BitVec 64)))
(define-fun expected64 () (_ BitVec 64)
  (select image64 (bvadd hint_base (bvshl case_key (_ bv3 64)))))
(define-fun actual64 () (_ BitVec 64)
  (select ram64 (bvadd current_base (bvshl current_index (_ bv3 64)))))
(define-fun original64 () (_ BitVec 64)
  (ite ready actual64 prefix_pc))
(define-fun guarded64 () (_ BitVec 64)
  (ite ready
    (ite (and key_match (= actual64 expected64)) expected64 actual64)
    prefix_pc))
(echo "absolute64: guarded control is preserved")
(push 1)
(assert (not (= original64 guarded64)))
(check-sat)
(pop 1)
(echo "absolute64: fast case is reachable")
(push 1)
(assert ready)
(assert key_match)
(assert (= actual64 expected64))
(check-sat)
(pop 1)
(echo "absolute64: unchecked static case fails after a table rewrite")
(push 1)
(assert ready)
(assert snapshot_valid)
(assert (= snapshot_key (_ bv0 64)))
(assert (= case_key (_ bv0 64)))
(assert (= current_index (_ bv0 64)))
(assert (= hint_base #x0000000000500000))
(assert (= current_base hint_base))
(assert (= expected64 #x0000000000401100))
(assert (= actual64 #x0000000000401200))
(define-fun unchecked64 () (_ BitVec 64)
  (ite ready (ite key_match expected64 actual64) prefix_pc))
(assert (not (= original64 unchecked64)))
(check-sat)
(get-value (original64 unchecked64 expected64 actual64))
(pop 1)
(pop 1)

; Relative 32-bit entries additionally allow independent biases and extension.
(push 1)
(declare-fun image32 () (Array (_ BitVec 64) (_ BitVec 32)))
(declare-fun ram32 () (Array (_ BitVec 64) (_ BitVec 32)))
(declare-fun hint_bias () (_ BitVec 64))
(declare-fun current_bias () (_ BitVec 64))
(declare-fun hint_signed () Bool)
(declare-fun current_signed () Bool)
(define-fun extend32 ((n (_ BitVec 32)) (signed Bool)) (_ BitVec 64)
  (ite signed ((_ sign_extend 32) n) ((_ zero_extend 32) n)))
(define-fun expected32 () (_ BitVec 64)
  (bvadd hint_bias
    (extend32
      (select image32 (bvadd hint_base (bvshl case_key (_ bv2 64))))
      hint_signed)))
(define-fun actual32 () (_ BitVec 64)
  (bvadd current_bias
    (extend32
      (select ram32 (bvadd current_base (bvshl current_index (_ bv2 64))))
      current_signed)))
(define-fun original32 () (_ BitVec 64)
  (ite ready actual32 prefix_pc))
(define-fun guarded32 () (_ BitVec 64)
  (ite ready
    (ite (and key_match (= actual32 expected32)) expected32 actual32)
    prefix_pc))
(echo "relative32: guarded control is preserved")
(push 1)
(assert (not (= original32 guarded32)))
(check-sat)
(pop 1)
(echo "relative32: fast case is reachable")
(push 1)
(assert ready)
(assert key_match)
(assert (= actual32 expected32))
(check-sat)
(pop 1)
(echo "relative32: unchecked static case fails after a table rewrite")
(push 1)
(assert ready)
(assert snapshot_valid)
(assert (= snapshot_key (_ bv0 64)))
(assert (= case_key (_ bv0 64)))
(assert (= current_index (_ bv0 64)))
(assert (= hint_base #x0000000000500000))
(assert (= current_base hint_base))
(assert (= hint_bias hint_base))
(assert (= current_bias hint_bias))
(assert hint_signed)
(assert current_signed)
(assert (= expected32 #x0000000000401100))
(assert (= actual32 #x0000000000401200))
(define-fun unchecked32 () (_ BitVec 64)
  (ite ready (ite key_match expected32 actual32) prefix_pc))
(assert (not (= original32 unchecked32)))
(check-sat)
(get-value (original32 unchecked32 expected32 actual32))
(pop 1)
(pop 1)
